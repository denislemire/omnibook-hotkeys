+
+/* ALC245 vendor widget 0x20, coefficient 0x0b bits 3:2. */
+static void
+hdaa_speaker_led_apply(void *arg, int pending __unused)
+{
+	struct hdaa_devinfo *di = arg;
+	device_t dev = di->dev;
+	uint32_t index, value, bits;
+
+	hdaa_lock(di);
+	index = hda_command(dev, HDA_CMD_GET_COEFF_INDEX(0, 0x20));
+	if (index <= 0xffff) {
+		hda_command(dev, HDA_CMD_SET_COEFF_INDEX(0, 0x20, 0x0b));
+		value = hda_command(dev, HDA_CMD_GET_PROCESSING_COEFF(0, 0x20));
+		bits = atomic_load_acq_int(&di->speaker_led_on) ? 8 : 4;
+		if (value <= 0xffff && (value & 0x0c) != bits) {
+			hda_command(dev, HDA_CMD_SET_COEFF_INDEX(0, 0x20, 0x0b));
+			hda_command(dev, HDA_CMD_SET_PROCESSING_COEFF(0, 0x20,
+			    (value & ~0x0c) | bits));
+		}
+		hda_command(dev, HDA_CMD_SET_COEFF_INDEX(0, 0x20, index));
+	}
+	hdaa_unlock(di);
+}
+
+static void
+hdaa_speaker_led_set(void *arg, int on)
+{
+	struct hdaa_devinfo *di = arg;
+
+	atomic_store_rel_int(&di->speaker_led_on, on != 0);
+	taskqueue_enqueue(taskqueue_thread, &di->speaker_led_task);
 }
 
