+static void
+backlight_brightness_request(void *arg, const char *alias, bool write,
+    int *level, int *error)
+{
+	struct backlight_softc *sc = arg;
+	struct backlight_props props = { 0 };
+
+	if (sc->alias == NULL || strcmp(devtoname(sc->alias), alias) != 0)
+		return;
+	if (write && (*level < 0 || *level > 100)) {
+		*error = EINVAL;
+		return;
+	}
+	sx_xlock(&sc->io_lock);
+	if (write) {
+		props.brightness = *level;
+		*error = BACKLIGHT_UPDATE_STATUS(sc->dev, &props);
+	} else {
+		*error = BACKLIGHT_GET_STATUS(sc->dev, &props);
+		if (*error == 0)
+			*level = props.brightness;
+	}
+	if (*error == 0)
+		sc->cached_brightness = props.brightness;
+	sx_xunlock(&sc->io_lock);
+}
