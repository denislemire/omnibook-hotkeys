+	if (hda_get_vendor_id(dev) == 0x10ec &&
+	    hda_get_device_id(dev) == 0x0245 &&
+	    hda_get_subsystem_id(dev) == 0x103c8e0a &&
+	    HDA_PARAM_GPIO_COUNT_NUM_GPIO(devinfo->gpio_cap) >= 3) {
+		TASK_INIT(&devinfo->mic_led_task, 0, hdaa_mic_led_apply, devinfo);
+		devinfo->mic_led = led_create_state(hdaa_mic_led_set, devinfo,
+		    "omnibook-micmute", 0);
+	}
 	bus_attach_children(dev);
