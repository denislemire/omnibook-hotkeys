+
+/* The LED callback runs under led(4)'s mutex. Defer codec I/O. */
+static void
+hdaa_mic_led_apply(void *arg, int pending __unused)
+{
+	struct hdaa_devinfo *di = arg;
+	uint32_t action;
+
+	hdaa_lock(di);
+	action = atomic_load_acq_int(&di->mic_led_on) ?
+	    HDAA_GPIO_CLEAR(2) : HDAA_GPIO_SET(2);
+	di->gpio = (di->gpio & ~HDAA_GPIO_MASK(2)) | action;
+	di->newgpio = di->gpio;
+	hdaa_gpio_commit(di);
+	hdaa_unlock(di);
+}
+
+static void
+hdaa_mic_led_set(void *arg, int on)
+{
+	struct hdaa_devinfo *di = arg;
+
+	atomic_store_rel_int(&di->mic_led_on, on != 0);
+	taskqueue_enqueue(taskqueue_thread, &di->mic_led_task);
 }
 
